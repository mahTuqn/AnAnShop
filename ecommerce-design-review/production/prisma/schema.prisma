generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  BLOCKED
  @@map("user_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  @@map("product_status")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  @@map("cart_status")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  @@map("order_status")
}

enum PaymentMethod {
  COD
  MOMO
  VNPAY
  CARD
  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
  @@map("payment_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  @@map("discount_type")
}

enum CouponScope {
  ORDER
  PRODUCT
  CATEGORY
  @@map("coupon_scope")
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESERVE
  RELEASE
  @@map("inventory_movement_type")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?    @db.VarChar(320)
  phone           String?    @db.VarChar(20)
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name") @db.VarChar(150)
  avatarUrl       String?    @map("avatar_url")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  @@map("users")
}

model Category {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?    @map("parent_id") @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?
  imageUrl    String?    @map("image_url")
  position    Int        @default(0)
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  @@map("categories")
}

model Product {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  name             String        @db.VarChar(200)
  slug             String        @unique @db.VarChar(220)
  shortDescription String?       @map("short_description") @db.VarChar(500)
  description      String?
  material         String?
  careInstructions String?       @map("care_instructions")
  status           ProductStatus @default(DRAFT)
  featured         Boolean       @default(false)
  metadata         Json          @default("{}")
  publishedAt      DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  category         Category      @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          Review[]
  @@map("products")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text") @db.VarChar(255)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, position])
  @@map("product_images")
}

model ProductVariant {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  sku            String         @unique @db.VarChar(80)
  barcode        String?        @unique @db.VarChar(80)
  price          Decimal        @db.Decimal(14, 2)
  compareAtPrice Decimal?       @map("compare_at_price") @db.Decimal(14, 2)
  costPrice      Decimal?       @map("cost_price") @db.Decimal(14, 2)
  weightGrams    Int?           @map("weight_grams")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      InventoryItem?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  @@map("product_variants")
}

model InventoryItem {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variantId     String           @unique @map("variant_id") @db.Uuid
  onHand        Int              @default(0) @map("on_hand")
  reserved      Int              @default(0)
  lowStockLevel Int              @default(5) @map("low_stock_level")
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  variant       ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements     InventoryMovement[]
  @@map("inventory_items")
}

model InventoryMovement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId String                @map("inventory_item_id") @db.Uuid
  type            InventoryMovementType
  quantity        Int
  referenceType   String?               @map("reference_type") @db.VarChar(50)
  referenceId     String?               @map("reference_id") @db.Uuid
  note            String?
  createdBy       String?               @map("created_by") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  inventory       InventoryItem         @relation(fields: [inventoryItemId], references: [id])
  @@map("inventory_movements")
}

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  sessionId String?    @map("session_id") @db.VarChar(128)
  status    CartStatus @default(ACTIVE)
  currency  String     @default("VND") @db.Char(3)
  expiresAt DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  @@map("carts")
}

model CartItem {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int
  unitPrice Decimal        @map("unit_price") @db.Decimal(14, 2)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Coupon {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String       @db.VarChar(50)
  name              String       @db.VarChar(150)
  description       String?
  type              DiscountType
  scope             CouponScope  @default(ORDER)
  value             Decimal      @db.Decimal(14, 2)
  minimumOrder      Decimal      @default(0) @map("minimum_order") @db.Decimal(14, 2)
  maximumDiscount   Decimal?     @map("maximum_discount") @db.Decimal(14, 2)
  usageLimit        Int?         @map("usage_limit")
  usageLimitPerUser Int?         @map("usage_limit_per_user")
  startsAt          DateTime     @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime     @map("ends_at") @db.Timestamptz(6)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("coupons")
}

model Order {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String        @unique @db.VarChar(30)
  userId         String?       @map("user_id") @db.Uuid
  guestEmail     String?       @map("guest_email") @db.VarChar(320)
  guestPhone     String?       @map("guest_phone") @db.VarChar(20)
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  currency       String        @default("VND") @db.Char(3)
  subtotal       Decimal       @db.Decimal(14, 2)
  shippingFee    Decimal       @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  discountTotal  Decimal       @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal       Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  grandTotal     Decimal       @map("grand_total") @db.Decimal(14, 2)
  customerNote   String?       @map("customer_note")
  adminNote      String?       @map("admin_note")
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(100)
  placedAt       DateTime      @default(now()) @map("placed_at") @db.Timestamptz(6)
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user           User?         @relation(fields: [userId], references: [id])
  addresses      OrderAddress[]
  items          OrderItem[]
  payments       Payment[]
  @@map("orders")
}

model OrderAddress {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId    String @map("order_id") @db.Uuid
  type       String @default("SHIPPING") @db.VarChar(20)
  fullName   String @map("full_name") @db.VarChar(150)
  phone      String @db.VarChar(20)
  email      String? @db.VarChar(320)
  province   String @db.VarChar(100)
  district   String @db.VarChar(100)
  ward       String @db.VarChar(100)
  line1      String @db.VarChar(255)
  postalCode String? @map("postal_code") @db.VarChar(20)
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@unique([orderId, type])
  @@map("order_addresses")
}

model OrderItem {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String          @map("order_id") @db.Uuid
  variantId      String?         @map("variant_id") @db.Uuid
  productId      String?         @map("product_id") @db.Uuid
  productName    String          @map("product_name") @db.VarChar(200)
  variantName    String?         @map("variant_name") @db.VarChar(200)
  sku            String          @db.VarChar(80)
  imageUrl       String?         @map("image_url")
  attributes     Json            @default("{}")
  quantity       Int
  unitPrice      Decimal         @map("unit_price") @db.Decimal(14, 2)
  discountAmount Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  lineTotal      Decimal         @map("line_total") @db.Decimal(14, 2)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  product        Product?        @relation(fields: [productId], references: [id])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  method                PaymentMethod
  provider              String?       @db.VarChar(50)
  status                PaymentStatus @default(PENDING)
  amount                Decimal       @db.Decimal(14, 2)
  currency              String        @default("VND") @db.Char(3)
  providerTransactionId String?       @map("provider_transaction_id") @db.VarChar(150)
  idempotencyKey        String        @unique @map("idempotency_key") @db.VarChar(100)
  metadata              Json          @default("{}")
  failedAt              DateTime?     @map("failed_at") @db.Timestamptz(6)
  failureReason         String?       @map("failure_reason")
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  order                 Order         @relation(fields: [orderId], references: [id])
  @@map("payments")
}


enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  @@map("review_status")
}

model Review {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  productId        String       @map("product_id") @db.Uuid
  orderItemId      String?      @map("order_item_id") @db.Uuid
  rating           Int
  title            String?      @db.VarChar(150)
  content          String?      @db.VarChar(3000)
  verifiedPurchase Boolean      @default(false) @map("verified_purchase")
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  moderatedAt      DateTime?    @map("moderated_at") @db.Timestamptz(6)
  user             User         @relation(fields: [userId], references: [id])
  product          Product      @relation(fields: [productId], references: [id])
  images           ReviewImage[]
  @@map("reviews")
}

model ReviewImage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId String @map("review_id") @db.Uuid
  url      String
  position Int    @default(0)
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  @@map("review_images")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId   String   @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(100)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id") @db.Uuid
  beforeData    Json?    @map("before_data")
  afterData     Json?    @map("after_data")
  ipAddress     String?  @map("ip_address") @db.Inet
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuthToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(50)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("auth_tokens")
}

model ReturnRequest {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  status      String   @db.VarChar(50)
  reason      String   @db.VarChar(500)
  adminNote   String?  @map("admin_note") @db.VarChar(500)
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  wasAccepted Boolean  @default(false) @map("was_accepted")
  @@map("return_requests")
}

model CouponRedemption {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId String  @map("coupon_id") @db.Uuid
  orderId  String  @map("order_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  @@map("coupon_redemptions")
}

model CouponProduct {
  couponId  String @map("coupon_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String @map("coupon_id") @db.Uuid
  categoryId String @map("category_id") @db.VarChar(50)
  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model Notification {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  channel      String   @db.VarChar(50)
  templateCode String   @map("template_code") @db.VarChar(100)
  recipient    String   @db.VarChar(255)
  payload      Json     @db.JsonB
  status       String   @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("notifications")
}

model OrderStatusEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String   @db.VarChar(50)
  adminNote String?  @map("admin_note") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("order_status_events")
}

model ReturnItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  returnRequestId String   @map("return_request_id") @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  quantity        Int
  refundAmount    Decimal  @map("refund_amount") @db.Decimal
  condition       String?  @db.VarChar(100)
  resolution      String?  @db.VarChar(100)
  @@map("return_items")
}

model Refund {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String   @map("payment_id") @db.Uuid
  returnRequestId String   @map("return_request_id") @db.Uuid
  amount          Decimal  @db.Decimal
  reason          String?  @db.VarChar(1000)
  status          String   @db.VarChar(50)
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("refunds")
}

model ContentEntry {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             String
  status           String    @default("DRAFT") @db.VarChar(50)
  slug             String    @db.VarChar(255)
  title            String    @db.VarChar(255)
  excerpt          String?
  body             Json      @default("{}")
  featuredImageUrl String?   @map("featured_image_url") @db.VarChar(1000)
  seoTitle         String?   @map("seo_title") @db.VarChar(255)
  seoDescription   String?   @map("seo_description")
  authorId         String    @map("author_id") @db.Uuid
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("content_entries")
}
